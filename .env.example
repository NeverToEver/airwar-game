# Air War — 环境变量样例
# 复制到 .env (或用 direnv 加载) 以覆盖默认行为.
# 当前开发约束见 Agent.md。

# === 运行时数据 / 缓存 ===
# AIRWAR_DATA_DIR=~/Library/Application Support/airwar
# AIRWAR_CACHE_DIR=~/Library/Caches/airwar
# AIRWAR_GENERATED_ASSET_DIR=/tmp/airwar-generated-assets

# === 远程排行榜（本地模拟）===
# AIRWAR_LEADERBOARD_URL=http://localhost:8000
# AIRWAR_LEADERBOARD_MODE=auto        # auto | remote | local
# AIRWAR_LEADERBOARD_TIMEOUT=3.0
# AIRWAR_LEADERBOARD_DB_PATH=~/Library/Application Support/airwar/leaderboard.db

# === 构建 / 启动 ===
# AIRWAR_INSTALL_DEPS=1         # run.sh 自动装 Rust 工具链
# AIRWAR_KEEP_BUILD_VENV=1     # build_*.sh 打包后保留 .venv-build/
